# ── Lightweight Dev Environment ────────────────────────────────
# Option A: Homebrew MySQL (no Docker needed, ~0.5 GB RAM)
# Option B: docker compose -f docker-compose.dev.yml up -d (~1.5 GB RAM)

# MySQL (Homebrew default: no password for root)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=startup_research

# Redis (optional — code has in-memory fallback)
# Install: brew install redis && brew services start redis
# REDIS_URL=redis://localhost:6379/0

# JWT (dev only — use a real secret in production)
JWT_SECRET=dev-jwt-secret-change-in-prod

# Logging
LOG_LEVEL=DEBUG

# ── Disabled Services (not needed for dev) ────────────────────
# Ollama: not running in dev, agents will use fallback/mock
# OLLAMA_URL is intentionally unset

# These are NOT started in dev mode:
# QDRANT_URL=        # Vector search — skipped
# ELASTICSEARCH_URL= # Full-text search — skipped
# TIMESCALEDB_URL=   # Time-series — skipped
# KAFKA_BOOTSTRAP_SERVERS= # Streaming — skipped
